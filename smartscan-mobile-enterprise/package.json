{
  "name": "smartscan-mobile-enterprise",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:https": "node scripts/dev-https.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "build:android": "node ../scripts/build-native-android.mjs",
    "build:android:bundle": "node ../scripts/build-native-android.mjs bundleRelease",
    "prepare:ios": "npm run build && npx cap copy ios"
  },
  "dependencies": {
    "@capacitor/android": "7.6.10",
    "@capacitor/core": "^7.4.4",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "7.6.10",
    "@tanstack/react-query": "^5.90.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.2",
    "mkcert": "^3.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
