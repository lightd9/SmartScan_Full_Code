# RPC endpoints (any provider URL works, e.g. Infura, Alchemy, QuickNode)
SEPOLIA_QUICKNODE_KEY=https://sepolia.infura.io/v3/your_api_key
# Ethereum mainnet alias. For another EVM production chain, use the explicit
# PRODUCTION_RPC_URL + PRODUCTION_CHAIN_ID pair below instead of assuming mainnet.
PROD_QUICKNODE_KEY=
PRODUCTION_RPC_URL=
PRODUCTION_CHAIN_ID=

# Deployer wallet private key (never commit the real value)
PRIVATE_KEY=your_wallet_private_key

# Optional initial role grants performed by scripts/deploy-v2.js. These are
# public wallet addresses supplied by the organizations; they are not derived
# from usernames and must never be private keys. Leave them blank to deploy
# first, then grant roles through the audited administration workflow.
# Every participant address must be unique and different from the deployer.
MANUFACTURER_ADDRESS=
MANUFACTURER_NAME=
SUPPLIER_ADDRESS=
SUPPLIER_NAME=
RETAILER_ADDRESS=
RETAILER_NAME=

# Role administration (scripts/manage-roles.js)
CONTRACT_ADDRESS=
ROLE_ADDRESS=
ROLE_NAME=manufacturer
ROLE_BUSINESS_NAME=
ROLE_ACTION=
ROLE_CONFIRMATION=
CONTRACT_DEPLOYMENT_BLOCK=

# Two-step contract ownership administration (never run without deliberate review).
# OWNER_ACTION is propose, accept, or prepare-safe-accept.
OWNER_ACTION=
OWNER_ADDRESS=
OWNER_CONFIRMATION=
