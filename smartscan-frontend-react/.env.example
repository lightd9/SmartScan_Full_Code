REACT_APP_API_URL=http://localhost:5000
# Set this to the deployed IdenteefiV2 address; no legacy contract fallback.
REACT_APP_CONTRACT_ADDRESS=
# These values are embedded in public browser bundles. Use public/read-only RPC,
# never a private key or provider credential that must remain confidential.
# Keep chain ID, RPC, explorer, backend CHAIN_ID, and contract address aligned.
REACT_APP_CHAIN_ID=11155111
REACT_APP_CHAIN_NAME=Sepolia Test Network
REACT_APP_CHAIN_RPC_URL=https://rpc.sepolia.org
REACT_APP_BLOCK_EXPLORER_URL=https://sepolia.etherscan.io
REACT_APP_NATIVE_CURRENCY_NAME=Sepolia Ether
REACT_APP_NATIVE_CURRENCY_SYMBOL=ETH
REACT_APP_NATIVE_CURRENCY_DECIMALS=18
# Optional: Google Geocoding API key. If unset, address lookup is disabled.
REACT_APP_GEOCODING_API_KEY=
