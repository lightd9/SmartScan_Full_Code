PORT=5000
TRUST_PROXY_HOPS=0
# Production forces TLS and certificate validation in pg; remove ssl/sslmode and
# other SSL query parameters from the URL so they cannot weaken that setting.
DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET=replace-with-a-long-random-string
OPERATIONAL_VAULT_SECRET=replace-with-a-different-long-random-string
# Optional previous vault/JWT key used only to decrypt existing version 1 rows after rotation.
# LEGACY_VAULT_SECRET=
JWT_EXPIRES_IN=1d
ALLOWED_ORIGINS=http://localhost:3000
CHAIN_RPC_URL=https://sepolia.infura.io/v3/your_api_key
CHAIN_ID=11155111
# Separate funded wallet used only for facility-wallet gas disbursement.
TREASURY_FAUCET_PRIVATE_KEY=
# Separate signer whose address must match owner() on CONTRACT_ADDRESS.
CONTRACT_OWNER_PRIVATE_KEY=
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
CONTRACT_DEPLOYMENT_BLOCK=
# Optional receipt pilot. Preserve CONTRACT_ADDRESS for existing V2 records.
RECEIPT_CONTRACT_ADDRESS=
# Comma-separated manufacturer usernames; empty keeps new products on V2.
RECEIPT_PILOT_ACCOUNTS=
# false rejects new V3 operations/approvals except recalls. Reads remain available.
# Previously queued/signed operations may still settle; this is not chain cancellation.
RECEIPT_WRITES_ENABLED=true
RECONCILE_CONFIRMATIONS=2
RECONCILE_HASHLESS_TIMEOUT_MS=900000
RECONCILE_SUBMITTED_TIMEOUT_MS=86400000
RECONCILE_INTERVAL_MS=60000
# Explicit retention policy required in production; scan monitoring rows (including
# opt-in approximate location and keyed visitor hashes) older than this are purged.
SCAN_RETENTION_DAYS=
SCAN_RETENTION_BATCH_SIZE=5000
SCAN_RETENTION_INTERVAL_MS=86400000
WALLET_LINK_ORIGIN=http://localhost:3000
# Local fallback is process memory; production requires rediss:// for shared rate limits across instances.
# REDIS_URL=redis://localhost:6379
# Production example: REDIS_URL=rediss://user:password@redis.example.com:6379
# Local development uses disk; production runtime requires S3-compatible object storage.
UPLOAD_STORAGE_DRIVER=local
# For production, use an S3 bucket with private access and grant this app only PutObject/GetObject access.
# Prefer the platform's workload/IAM credentials over static keys. Only configure a custom endpoint and
# force-path-style addressing when required by your S3-compatible provider.
# UPLOAD_STORAGE_DRIVER=s3
# UPLOAD_S3_BUCKET=smartscan-uploads
# UPLOAD_S3_REGION=us-east-1
# UPLOAD_S3_ENDPOINT=https://s3.example.com
# UPLOAD_S3_FORCE_PATH_STYLE=false
# UPLOAD_S3_ACCESS_KEY_ID=
# UPLOAD_S3_SECRET_ACCESS_KEY=
# UPLOAD_SIGNED_URL_TTL_SECONDS=300
# Set to 1 to disable SSL when connecting to a local PostgreSQL (no TLS)
# PGSSL_DISABLE=1
# Local development only, if using a database with a self-signed TLS certificate:
# PGSSL_REJECT_UNAUTHORIZED=false
